# Auto detect text files and perform LF normalization
* text=auto

# Source code files - force LF line endings in repository
*.cs text diff=csharp
*.cshtml text
*.json text
*.xml text
*.config text
*.css text
*.js text
*.html text
*.md text

# Windows specific build scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files (git LFS / binary marking)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.zip binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.db binary
*.sqlite binary